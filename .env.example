# ==============================================================================
# Johnrois Stainless Steel Fabrication Shop — Environment Configuration
# ==============================================================================
# Copy to `.env` for local customization or add to Vercel Project Settings →
# Environment Variables for cloud production persistence.
# Never expose database credentials in VITE_* frontend variables.

# --- OPTION A: Cloud PostgreSQL (Neon / Vercel Postgres / Supabase) ---
# Automatically detected from DATABASE_URL, POSTGRES_URL, NEON_DATABASE_URL,
# POSTGRES_PRISMA_URL, DATABASE_URL_UNPOOLED, POSTGRES_URL_NON_POOLING,
# or custom-prefixed *_DATABASE_URL / *_POSTGRES_URL variables injected by Vercel.
DATABASE_URL=
POSTGRES_URL=

# --- OPTION B: Turso / LibSQL Cloud SQLite ---
# Alternative serverless SQLite database (https://turso.tech).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- OPTION C: Self-Hosted / Local Persistent SQLite ---
# Used automatically when running `npm start` or `npm run dev` on a server/PC.
# Optional custom path (defaults to ./data/johnrois.sqlite):
SQLITE_DB_PATH=

# --- Optional Server / Split-Origin Settings ---
PORT=3000
CORS_ORIGIN=
VITE_API_BASE_URL=
